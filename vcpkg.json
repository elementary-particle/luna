{
  "dependencies": [
    "fmt",
    {
      "name": "dbus",
      "default-features": false,
      "platform": "linux"
    },
    "vulkan-memory-allocator",
    {
      "name": "sdl3",
      "features": [
        "vulkan"
      ]
    },
    {
      "name": "sdl3-mixer",
      "features": [
        "wave",
        "vorbis",
        "opus",
        "mp3"
      ]
    },
    {
      "name": "skia",
      "default-features": false,
      "features": [
        "vulkan",
        "graphite",
        "freetype",
        "harfbuzz",
        "jpeg",
        "png",
        "webp"
      ]
    }
  ]
}