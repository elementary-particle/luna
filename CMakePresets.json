{
  "version": 6,
  "configurePresets": [
    {
      "name": "vcpkg",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "environment": {},
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg-ports",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/vcpkg-triplets"
      }
    },
    {
      "name": "vcpkg-x64-linux",
      "inherits": "vcpkg",
      "environment": {
        "VCPKG_DEFAULT_TRIPLET": "x64-linux-clang-lto"
      },
      "cacheVariables": {
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/vcpkg-triplets/linux-clang-toolchain.cmake",
        "VCPKG_TARGET_ARCHITECTURE": "x64",
        "VCPKG_CRT_LINKAGE": "dynamic",
        "VCPKG_LIBRARY_LINKAGE": "static",
        "VCPKG_HOST_TRIPLET": "x64-linux-clang-lto",
        "VCPKG_TARGET_TRIPLET": "x64-linux-clang-lto",
        "VCPKG_USE_LTO": "ON"
      }
    },
    {
      "name": "vcpkg-x64-linux-debug",
      "inherits": "vcpkg",
      "environment": {
        "VCPKG_DEFAULT_TRIPLET": "x64-linux-clang-dynamic"
      },
      "cacheVariables": {
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/vcpkg-triplets/linux-clang-toolchain.cmake",
        "VCPKG_TARGET_ARCHITECTURE": "x64",
        "VCPKG_CRT_LINKAGE": "dynamic",
        "VCPKG_LIBRARY_LINKAGE": "dynamic",
        "VCPKG_HOST_TRIPLET": "x64-linux-clang-dynamic",
        "VCPKG_TARGET_TRIPLET": "x64-linux-clang-dynamic",
        "LUNA_ENABLE_SANITIZERS": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "vcpkg-x64-windows",
      "inherits": "vcpkg",
      "environment": {
        "VCPKG_DEFAULT_TRIPLET": "x64-windows-clangcl-lto"
      },
      "cacheVariables": {
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/vcpkg-triplets/windows-clangcl-toolchain.cmake",
        "VCPKG_TARGET_ARCHITECTURE": "x64",
        "VCPKG_CRT_LINKAGE": "static",
        "VCPKG_LIBRARY_LINKAGE": "static",
        "VCPKG_HOST_TRIPLET": "x64-windows-clangcl-lto",
        "VCPKG_TARGET_TRIPLET": "x64-windows-clangcl-lto",
        "VCPKG_USE_LTO": "ON"
      }
    }
  ]
}
